erDiagram
  users ||--o| creator_profiles : "user_id"
  creator_profiles ||--|{ portfolio_videos : "creator_id"
  creator_profiles ||--|{ packages : "creator_id"
  users ||--o{ brands : "smm_user_id"
  users ||--o{ briefs : "business_id"
  brands |o--o{ briefs : "brand_id"
  briefs ||--o{ responses : "brief_id"
  creator_profiles ||--o{ responses : "creator_id"
  briefs ||--o| orders : "brief_id"
  creator_profiles ||--o{ orders : "creator_id"
  orders ||--|{ order_items : "order_id"
  packages ||--o{ order_items : "package_id"
  orders ||--o{ payments : "order_id"
  orders ||--o{ deliveries : "order_id"
  orders ||--o{ revision_requests : "order_id"
  orders ||--o| disputes : "order_id"
  users ||--o{ disputes : "opened_by"
  orders ||--o| payouts : "order_id"
  creator_profiles ||--o{ payouts : "creator_id"
  orders ||--o| reviews : "order_id"
  orders ||--o{ messages : "order_id"
  users ||--o{ messages : "sender_id"
  users ||--o{ notifications : "user_id"
  orders |o--o{ notifications : "order_id"
  users {
    uuid id PK
    varchar13 phone UK
    varchar10 role
    varchar80 name
    bigint telegram_chat_id
    timestamptz created_at
  }
  creator_profiles {
    uuid id PK
    uuid user_id FK,UK
    varchar40 niche
    varchar20 languages
    text districts
    varchar15 tax_status
    varchar9 inn
    varchar15 moderation_status
    numeric rating
    int orders_done
  }
  portfolio_videos {
    uuid id PK
    uuid creator_id FK
    text url
    int duration_sec
    int size_mb
  }
  packages {
    uuid id PK
    uuid creator_id FK
    varchar60 title
    smallint videos
    bigint price
    smallint days
    smallint revision_rounds
    boolean is_active
  }
  brands {
    uuid id PK
    uuid smm_user_id FK
    varchar80 name
    varchar60 instagram
  }
  briefs {
    uuid id PK
    uuid business_id FK
    uuid brand_id FK
    varchar30 format
    smallint videos
    text address
    date shoot_date
    date due_date
    bigint budget
    varchar10 language
    varchar15 status
  }
  responses {
    uuid id PK
    uuid brief_id FK
    uuid creator_id FK
    bigint price
    smallint days
    varchar10 status
  }
  orders {
    uuid id PK
    uuid brief_id FK,UK
    uuid creator_id FK
    varchar20 status
    smallint revision_rounds
    smallint rounds_used
    bigint subtotal
    bigint commission
    bigint total
    timestamptz confirmed_at
    timestamptz accepted_at
  }
  order_items {
    uuid id PK
    uuid order_id FK
    uuid package_id FK
    smallint quantity
    bigint unit_price
    bigint line_total
  }
  payments {
    uuid id PK
    uuid order_id FK
    varchar10 provider
    varchar64 external_id UK
    bigint amount
    varchar12 status
    timestamptz held_at
  }
  deliveries {
    uuid id PK
    uuid order_id FK
    smallint round
    text video_url
    boolean watermarked
    timestamptz submitted_at
  }
  revision_requests {
    uuid id PK
    uuid order_id FK
    smallint round
    text comment
    timestamptz created_at
  }
  disputes {
    uuid id PK
    uuid order_id FK,UK
    uuid opened_by FK
    text reason
    varchar12 status
    varchar15 decision
    bigint refund_amount
    timestamptz resolved_at
  }
  payouts {
    uuid id PK
    uuid order_id FK,UK
    uuid creator_id FK
    bigint amount
    varchar12 status
    timestamptz paid_at
  }
  reviews {
    uuid id PK
    uuid order_id FK,UK
    smallint rating
    text text
    timestamptz created_at
  }
  messages {
    uuid id PK
    uuid order_id FK
    uuid sender_id FK
    text text
    text photo_url
    timestamptz created_at
  }
  notifications {
    uuid id PK
    uuid user_id FK
    uuid order_id FK
    varchar10 channel
    text text
    timestamptz sent_at
  }