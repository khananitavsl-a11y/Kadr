<bpmn:collaboration id="collab_tobe"><bpmn:participant id="col_tobe" name="Kadr: заказ ролика («как будет»)" processRef="tobe"/><bpmn:participant id="pool_pay" name="Payme / Click — платёжный партнёр"/><bpmn:messageFlow id="m1" sourceRef="t5" targetRef="pool_pay" name="данные карты"/><bpmn:messageFlow id="m2" sourceRef="t6" targetRef="pool_pay" name="чек с удержанием"/><bpmn:messageFlow id="m3" sourceRef="pool_pay" targetRef="t6" name="удержано / отказ"/><bpmn:messageFlow id="m4" sourceRef="t14" targetRef="pool_pay" name="возврат или выплата"/><bpmn:messageFlow id="m5" sourceRef="t16" targetRef="pool_pay" name="выплата креатору"/></bpmn:collaboration>
<bpmn:process id="tobe" isExecutable="false"><bpmn:laneSet id="ls_tobe"><bpmn:lane id="L_b" name="Владелец бизнеса"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t11</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_k" name="Креатор"><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t9</bpmn:flowNodeRef><bpmn:flowNodeRef>t13</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_s" name="Система Kadr"><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>t12</bpmn:flowNodeRef><bpmn:flowNodeRef>t14</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef><bpmn:flowNodeRef>t16</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="s1" name="Нужны ролики"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Найти креатора в каталоге с фильтрами"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Заполнить бриф: объём, срок, правки"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Рассмотреть бриф"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g1" name="Принять бриф?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t4" name="Зафиксировать условия заказа"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Оплатить заказ"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Создать платёж с удержанием, получить ответ"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g2" name="Оплата прошла?"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t7" name="Показать ошибку: деньги не списаны"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task><bpmn:task id="t8" name="Статус «Оплата удержана», уведомить креатора"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task><bpmn:task id="t9" name="Снять и загрузить ролики"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:task id="t10" name="Показать ролики с водяным знаком"><bpmn:incoming>f14</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task><bpmn:task id="t11" name="Проверить ролики"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g3" name="Решение по роликам"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f18</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t13" name="Внести правки"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:task><bpmn:task id="t12" name="Закрыть заказ"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:task><bpmn:task id="t14" name="Решить спор: вернуть деньги или выплатить"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e2" name="Спор решён"><bpmn:incoming>f21</bpmn:incoming></bpmn:endEvent><bpmn:task id="t16" name="Запросить выплату креатору"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e1" name="Заказ выполнен"><bpmn:incoming>f23</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/><bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/><bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1"/><bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t1" name="нет"/><bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="да"/><bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/><bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/><bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="g2"/><bpmn:sequenceFlow id="f10" sourceRef="g2" targetRef="t7" name="нет"/><bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t5"/><bpmn:sequenceFlow id="f12" sourceRef="g2" targetRef="t8" name="да"/><bpmn:sequenceFlow id="f13" sourceRef="t8" targetRef="t9"/><bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="t10"/><bpmn:sequenceFlow id="f15" sourceRef="t10" targetRef="t11"/><bpmn:sequenceFlow id="f16" sourceRef="t11" targetRef="g3"/><bpmn:sequenceFlow id="f17" sourceRef="g3" targetRef="t12" name="принять / 72 ч"/><bpmn:sequenceFlow id="f18" sourceRef="g3" targetRef="t13" name="правки"/><bpmn:sequenceFlow id="f19" sourceRef="t13" targetRef="t10"/><bpmn:sequenceFlow id="f20" sourceRef="g3" targetRef="t14" name="спор"/><bpmn:sequenceFlow id="f21" sourceRef="t14" targetRef="e2"/><bpmn:sequenceFlow id="f22" sourceRef="t12" targetRef="t16"/><bpmn:sequenceFlow id="f23" sourceRef="t16" targetRef="e1"/></bpmn:process>
