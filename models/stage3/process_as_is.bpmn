<bpmn:collaboration id="collab_asis"><bpmn:participant id="col_asis" name="Заказ ролика сегодня — без Kadr («как есть»)" processRef="asis"/></bpmn:collaboration>
<bpmn:process id="asis" isExecutable="false"><bpmn:laneSet id="ls_asis"><bpmn:lane id="L_b" name="Владелец бизнеса"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef><bpmn:flowNodeRef>t9</bpmn:flowNodeRef><bpmn:flowNodeRef>t10</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_k" name="Креатор"><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="s1" name="Нужны ролики"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="t1" name="Искать креатора в Instagram, Telegram, у знакомых"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:task id="t2" name="Написать креатору в директ"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task><bpmn:task id="t3" name="Ответить и назвать цену"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g1" name="Цена и сроки устраивают?"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t4" name="Перевести предоплату на карту"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task><bpmn:task id="t5" name="Снять и смонтировать ролики"><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:task id="t6" name="Отправить ролики в мессенджер"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task><bpmn:task id="t7" name="Посмотреть ролики"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g2" name="Ролики устраивают?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t8" name="Перевести остаток оплаты"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e1" name="Ролики получены"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent><bpmn:task id="t9" name="Попросить правки в переписке"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g3" name="Креатор согласен переделать?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t10" name="Спорить в переписке"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e2" name="Деньги и время потеряны"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/><bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/><bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1"/><bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t1" name="нет"/><bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="да"/><bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/><bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/><bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="t7"/><bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="g2"/><bpmn:sequenceFlow id="f11" sourceRef="g2" targetRef="t8" name="да"/><bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="e1"/><bpmn:sequenceFlow id="f13" sourceRef="g2" targetRef="t9" name="нет"/><bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="g3"/><bpmn:sequenceFlow id="f15" sourceRef="g3" targetRef="t5" name="да"/><bp