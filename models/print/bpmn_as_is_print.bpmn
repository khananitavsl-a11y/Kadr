="Посмотреть ролики"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g2" name="Ролики устраивают?"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t8" name="Перевести остаток оплаты"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e1" name="Ролики получены"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent><bpmn:task id="t9" name="Попросить правки в переписке"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g3" name="Креатор согласен переделать?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t10" name="Спорить в переписке"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task><bpmn:endEvent id="e2" name="Деньги и время потеряны"><bpmn:incoming>f17</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1"/><bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2"/><bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="t3"/><bpmn:sequenceFlow id="f4" sourceRef="t3" targetRef="g1"/><bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t1" name="нет"/><bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="t4" name="да"/><bpmn:sequenceFlow id="f7" sourceRef="t4" targetRef="t5"/><bpmn:sequenceFlow id="f8" sourceRef="t5" targetRef="t6"/><bpmn:sequenceFlow id="f9" sourceRef="t6" targetRef="t7"/><bpmn:sequenceFlow id="f10" sourceRef="t7" targetRef="g2"/><bpmn:sequenceFlow id="f11" sourceRef="g2" targetRef="t8" name="да"/><bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="e1"/><bpmn:sequenceFlow id="f13" sourceRef="g2" targetRef="t9" name="нет"/><bpmn:sequenceFlow id="f14" sourceRef="t9" targetRef="g3"/><bpmn:sequenceFlow id="f15" sourceRef="g3" targetRef="t5" name="да"/><bp