digraph G {
graph [rankdir=TB, splines=true, nodesep=0.18, ranksep=0.6, fontname="Liberation Sans", pad=0.2, bgcolor="white"];
node [shape=plain, fontname="Liberation Sans"];
edge [arrowhead=none, color="#555555", penwidth=2.2, fontname="Liberation Sans", fontsize=19, labelfontsize=19, labelfontcolor="#1D4ED8", labeldistance=1.4, labelangle=35];
User [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F2C98A"><B><FONT POINT-SIZE="25">User</FONT></B><BR/><FONT POINT-SIZE="20">Пользователь · М1</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FDF3E3"><FONT POINT-SIZE="21">phone: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FDF3E3"><FONT POINT-SIZE="21">role: Role</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FDF3E3"><FONT POINT-SIZE="21">name: String</FONT></TD></TR></TABLE>>];
CreatorProfile [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#A8D5A2"><B><FONT POINT-SIZE="25">CreatorProfile</FONT></B><BR/><FONT POINT-SIZE="20">Профиль креатора · М2</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">niche: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">languages: String[]</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">taxStatus: TaxStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">rating: Decimal</FONT></TD></TR></TABLE>>];
PortfolioVideo [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#A8D5A2"><B><FONT POINT-SIZE="25">PortfolioVideo</FONT></B><BR/><FONT POINT-SIZE="20">Видео портфолио · М2</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">url: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">durationSec: Int</FONT></TD></TR></TABLE>>];
Package [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#A8D5A2"><B><FONT POINT-SIZE="25">Package</FONT></B><BR/><FONT POINT-SIZE="20">Пакет · М2</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">videos: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">price: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">days: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF7EC"><FONT POINT-SIZE="21">revisionRounds: Int</FONT></TD></TR></TABLE>>];
Brand [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F2C98A"><B><FONT POINT-SIZE="25">Brand</FONT></B><BR/><FONT POINT-SIZE="20">Бренд · М1</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FDF3E3"><FONT POINT-SIZE="21">name: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FDF3E3"><FONT POINT-SIZE="21">instagram: String</FONT></TD></TR></TABLE>>];
Brief [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFB18C"><B><FONT POINT-SIZE="25">Brief</FONT></B><BR/><FONT POINT-SIZE="20">Бриф · М3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">format: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">videos: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">budget: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">status: BriefStatus</FONT></TD></TR></TABLE>>];
Response [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFB18C"><B><FONT POINT-SIZE="25">Response</FONT></B><BR/><FONT POINT-SIZE="20">Отклик · М3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">price: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">days: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">status: ResponseStatus</FONT></TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="4" COLOR="#C2410C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFB18C"><B><FONT POINT-SIZE="25">Order</FONT></B><BR/><FONT POINT-SIZE="20">Заказ · М3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">status: OrderStatus</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">roundsUsed: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">subtotal: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">commission: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">total: Money</FONT></TD></TR></TABLE>>];
OrderItem [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFB18C"><B><FONT POINT-SIZE="25">OrderItem</FONT></B><BR/><FONT POINT-SIZE="20">Позиция заказа · М3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">quantity: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">unitPrice: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">lineTotal: Money</FONT></TD></TR></TABLE>>];
Message [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFB18C"><B><FONT POINT-SIZE="25">Message</FONT></B><BR/><FONT POINT-SIZE="20">Сообщение · М3</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">text: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFF0E8"><FONT POINT-SIZE="21">photoUrl: String</FONT></TD></TR></TABLE>>];
Payment [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#A9B8F0"><B><FONT POINT-SIZE="25">Payment</FONT></B><BR/><FONT POINT-SIZE="20">Платёж · М4</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">provider: Provider</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">externalId: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">amount: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">status: PaymentStatus</FONT></TD></TR></TABLE>>];
Payout [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#A9B8F0"><B><FONT POINT-SIZE="25">Payout</FONT></B><BR/><FONT POINT-SIZE="20">Выплата · М4</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">amount: Money</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EEF1FC"><FONT POINT-SIZE="21">status: PayoutStatus</FONT></TD></TR></TABLE>>];
Delivery [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D3B1E8"><B><FONT POINT-SIZE="25">Delivery</FONT></B><BR/><FONT POINT-SIZE="20">Сдача роликов · М5</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F6EEFB"><FONT POINT-SIZE="21">round: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F6EEFB"><FONT POINT-SIZE="21">videoUrl: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F6EEFB"><FONT POINT-SIZE="21">watermarked: Bool</FONT></TD></TR></TABLE>>];
RevisionRequest [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#D3B1E8"><B><FONT POINT-SIZE="25">RevisionRequest</FONT></B><BR/><FONT POINT-SIZE="20">Запрос правок · М5</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F6EEFB"><FONT POINT-SIZE="21">round: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F6EEFB"><FONT POINT-SIZE="21">comment: String</FONT></TD></TR></TABLE>>];
Dispute [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F2A0A0"><B><FONT POINT-SIZE="25">Dispute</FONT></B><BR/><FONT POINT-SIZE="20">Спор · М6</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FCECEC"><FONT POINT-SIZE="21">reason: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FCECEC"><FONT POINT-SIZE="21">decision: Decision</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FCECEC"><FONT POINT-SIZE="21">refundAmount: Money</FONT></TD></TR></TABLE>>];
Review [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#9ED3D8"><B><FONT POINT-SIZE="25">Review</FONT></B><BR/><FONT POINT-SIZE="20">Отзыв · М7</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EAF6F7"><FONT POINT-SIZE="21">rating: Int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EAF6F7"><FONT POINT-SIZE="21">text: String</FONT></TD></TR></TABLE>>];
Notification [label=<<TABLE BORDER="1.6" COLOR="#333333" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#C9C9C9"><B><FONT POINT-SIZE="25">Notification</FONT></B><BR/><FONT POINT-SIZE="20">Уведомление · М8</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F3F3F3"><FONT POINT-SIZE="21">channel: Channel</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F3F3F3"><FONT POINT-SIZE="21">text: String</FONT></TD></TR></TABLE>>];
User -> CreatorProfile [taillabel="1", headlabel="0..1"];
User -> Brand [taillabel="1", headlabel="0..*", label=" ведёт SMM "];
User -> Brief [taillabel="1", headlabel="0..*", label=" создаёт "];
User -> Notification [taillabel="1", headlabel="0..*"];
Brand -> Brief [taillabel="0..1", headlabel="0..*"];
CreatorProfile -> PortfolioVideo [taillabel="1", headlabel="3..20", dir=both, arrowtail=diamond, arrowhead=none];
CreatorProfile -> Package [taillabel="1", headlabel="1..5", dir=both, arrowtail=diamond, arrowhead=none];
CreatorProfile -> Response [taillabel="1", headlabel="0..*"];
Brief -> Response [taillabel="1", headlabel="0..*"];
Brief -> Order [taillabel="1", headlabel="0..1"];
CreatorProfile -> Order [taillabel="1", headlabel="0..*"];
Order -> OrderItem [taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond, arrowhead=none];
Package -> OrderItem [taillabel="1", headlabel="0..*"];
Order -> Payment [taillabel="1", headlabel="0..*"];
Order -> Payout [taillabel="1", headlabel="0..1"];
Order -> Delivery [taillabel="1", headlabel="0..*"];
Order -> RevisionRequest [taillabel="1", headlabel="0..*"];
Order -> Dispute [taillabel="1", headlabel="0..1"];
Order -> Review [taillabel="1", headlabel="0..1"];
Order -> Message [taillabel="1", headlabel="0..*"];
User -> Message [taillabel="1", headlabel="0..*", label=" пишет "];
{rank=same; User; }
{rank=same; CreatorProfile; Brand; Notification;}
{rank=same; Brief; Package; PortfolioVideo;}
{rank=same; Response; Order; }
{rank=same; OrderItem; Payment; Payout; Message;}
{rank=same; Delivery; RevisionRequest; Dispute; Review;}
OrderItem -> Delivery [style=invis]; Payment -> RevisionRequest [style=invis]; Payout -> Dispute [style=invis]; Message -> Review [style=invis];
}