flowchart TD
  S(( )):::start --> B(Показать расчёт: цена пакета + комиссия 15% = итог)
  B --> D(Бизнес выбирает Payme или Click)
  D --> E(Создать платёж с удержанием, открыть страницу партнёра)
  E --> F(Бизнес вводит карту на странице партнёра)
  F --> G{Ответ?}
  G -- успешно --> H(Статус «Оплата удержана», уведомить креатора в Telegram)
  H --> Z2((( ))):::fin
  G -- отказ карты --> K(Экран ошибки: деньги не списаны)
  G -- нет ответа --> L(Сверить статус с партнёром через 15 мин) --> M{Найден?}
  M -- да --> H
  M -- нет --> K
  K --> N{Повторить?}
  N -- да --> D
  N -- нет: заказ «Ожидает оплаты» --> Z3((( ))):::fin
  classDef start fill:#111,stroke:#111;
  classDef fin fill:#111,stroke:#111,stroke-width:4px;
