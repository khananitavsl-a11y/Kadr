<mxfile host="app.diagrams.net" agent="Kadr Team01" version="24.0.0"><diagram id="customer_journey" name="Карта пути владельца бизнеса"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v3" value="&lt;b&gt;Этап&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16161D;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="170.0" height="60.0" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;Нужны ролики&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Поиск&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Договорённость&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="690.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Оплата&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="940.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Съёмка&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1190.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Сдача и правки&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1440.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Результат&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF5A1F;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1690.0" y="20.0" width="250.0" height="60.0" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Действия&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F4F0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="80.0" width="170.0" height="130.0" as="geometry"/></mxCell><mxCell id="v12" value="Новинка, акция или сезон; решает заказать, прикидывает бюджет" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="190.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v13" value="Листает Instagram и Telegram, спрашивает знакомых, смотрит OLX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v14" value="Переписка в директе: цена, дата, число роликов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v15" value="Переводит предоплату незнакомому человеку" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="940.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v16" value="Готовит товар и место, креатор снимает" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v17" value="Ждёт, напоминает, просит переделать" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v18" value="Публикует, смотрит отклик, решает о повторном заказе" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1690.0" y="80.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Боль&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F4F0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="210.0" width="170.0" height="130.0" as="geometry"/></mxCell><mxCell id="v20" value="Непонятно, сколько стоит ролик (H4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="190.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v21" value="От 2–3 дней до месяца в 3–4 приложениях (П1–П3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v22" value="Условия на словах — потом не хотят дорабатывать (П2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v23" value="Предоплата 50–100% незнакомцу (П2, П3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="940.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v24" value="Перенос съёмки, исполнитель опаздывает" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v25" value="Слабый ролик → конфликт (П3), нет ответа (П2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v26" value="Хочется вернуться к проверенному (П1, П2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEBE9;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1690.0" y="210.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Возможность Kadr&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F4F0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="340.0" width="170.0" height="130.0" as="geometry"/></mxCell><mxCell id="v28" value="Цены пакетов видны в каталоге — FR-05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="190.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v29" value="Каталог с фильтрами и сортировкой — FR-07, FR-08" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v30" value="Бриф и фиксация условий — FR-09, FR-13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v31" value="Удержание до приёмки — FR-15, FR-17" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="940.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v32" value="Дата и адрес в брифе, уведомления — FR-09, FR-26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1190.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v33" value="Срок в системе, лимит правок — FR-18, FR-21" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1440.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v34" value="Отзывы и рейтинг — FR-27, FR-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F4E8;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1690.0" y="340.0" width="250.0" height="130.0" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Эмоция&lt;/b&gt;&lt;br&gt;от −2 до +2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F4F0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20.0" y="470.0" width="170.0" height="220.0" as="geometry"/></mxCell><mxCell id="v36" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="190.0" y="470.0" width="1750.0" height="220.0" as="geometry"/></mxCell><mxCell id="v37" value="+1" style="ellipse;html=1;fillColor=#1E7F47;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="297.0" y="517.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="v38" value="-1" style="ellipse;html=1;fillColor=#C62B20;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="547.0" y="607.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="e39" value="" sty