ry></mxCell><mxCell id="e15" value="4. заказ «Условия подтверждены»?" style="html=1;verticalAlign=bottom;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870.0" y="278.0" as="sourcePoint"/><mxPoint x="1410.0" y="278.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="5. да, итог 1 380 000 сум" style="html=1;verticalAlign=bottom;fontSize=13;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1410.0" y="324.0" as="sourcePoint"/><mxPoint x="870.0" y="324.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="6. создать платёж (сумма, заказ)" style="html=1;verticalAlign=bottom;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870.0" y="370.0" as="sourcePoint"/><mxPoint x="1140.0" y="370.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="7. payment = «Создан»" style="html=1;verticalAlign=bottom;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="416.0" as="sourcePoint"/><mxPoint x="1410.0" y="416.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="8. создать чек с удержанием" style="html=1;verticalAlign=bottom;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="462.0" as="sourcePoint"/><mxPoint x="1680.0" y="462.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="9. ссылка на страницу оплаты" style="html=1;verticalAlign=bottom;fontSize=13;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1680.0" y="508.0" as="sourcePoint"/><mxPoint x="1140.0" y="508.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="10. перенаправить на страницу партнёра" style="html=1;verticalAlign=bottom;fontSize=13;dashed=1;endArrow=open;endFill=0;" ed