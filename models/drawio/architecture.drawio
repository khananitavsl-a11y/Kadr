<mxfile host="app.diagrams.net" agent="Kadr Team01" version="24.0.0"><diagram id="architecture" name="Архитектура"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v3" value='&lt;b&gt;1. Клиенты&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;то, что видит пользователь&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;fontColor=#FFFFFF;strokeColor=none;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="20.0" width="250.0" height="120.0" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="20.0" width="1700.0" height="120.0" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Веб-приложение&lt;/b&gt;&lt;br&gt;бизнес, креатор, SMM-менеджер · браузер телефона (PWA), узбекский и русский" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="305.0" y="35.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;Панель модератора&lt;/b&gt;&lt;br&gt;очередь профилей, споры · браузер компьютера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="866.7" y="35.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Telegram-бот&lt;/b&gt;&lt;br&gt;уведомления о статусе заказа, ссылка в кабинет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1428.3" y="35.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v8" value='&lt;b&gt;2. Шлюз&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;единая точка входа&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6D28D9;fontColor=#FFFFFF;strokeColor=none;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="195.0" width="250.0" height="120.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6D28D9;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="195.0" width="1700.0" height="120.0" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Nginx + API-шлюз&lt;/b&gt;&lt;br&gt;HTTPS, раздача фронтенда, ограничение частоты запросов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="305.0" y="210.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Авторизация&lt;/b&gt;&lt;br&gt;вход по SMS-коду, JWT-токен, роль, блокировка после 5 ошибок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="866.7" y="210.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Приём уведомлений партнёров&lt;/b&gt;&lt;br&gt;адреса для ответов Payme / Click, проверка подписи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1428.3" y="210.0" width="546.7" height="90.0" as="geometry"/></mxCell><mxCell id="v13" value='&lt;b&gt;3. Сервисы&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;модульный монолит&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C2410C;fontColor=#FFFFFF;strokeColor=none;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="370.0" width="250.0" height="250.0" as="geometry"/></mxCell><mxCell id="v14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4ED;strokeColor=#C2410C;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="370.0" width="1700.0" height="250.0" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;М1 Пользователи и вход&lt;/b&gt;&lt;br&gt;роли, профиль, SMS-коды" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="305.0" y="385.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;М2 Профили и каталог&lt;/b&gt;&lt;br&gt;портфолио, пакеты, фильтры, рейтинг" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="635.0" y="385.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;М3 Брифы и заказы&lt;/b&gt;&lt;br&gt;бриф, отклики, условия, статусы, чат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="965.0" y="385.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;М4 Платежи&lt;/b&gt;&lt;br&gt;удержание, сверка, возврат, выплата" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1295.0" y="385.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;М5 Сдача и приёмка&lt;/b&gt;&lt;br&gt;ролики, водяной знак, правки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="305.0" y="500.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;М6 Споры и модерация&lt;/b&gt;&lt;br&gt;очередь профилей, решения по спорам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="635.0" y="500.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;М7 Отзывы&lt;/b&gt;&lt;br&gt;оценки, расчёт рейтинга" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="965.0" y="500.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;М8 Уведомления&lt;/b&gt;&lt;br&gt;события → Telegram / SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1295.0" y="500.0" width="315.0" height="105.0" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Фоновые задачи&lt;/b&gt;&lt;br&gt;таймер автоприёмки 72 ч · сверка платежей каждые 15 мин · водяной знак · рассылка уведомлений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1630.0" y="385.0" width="345.0" height="220.0" as="geometry"/></mxCell><mxCell id="v24" value='&lt;b&gt;4. Данные&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;серверы в Узбекистане&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4D7C0F;fontColor=#FFFFFF;strokeColor=none;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="675.0" width="250.0" height="120.0" as="geometry"/></mxCell><mxCell id="v25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#4D7C0F;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="675.0" width="1700.0" height="120.0" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;17 таблиц: пользователи, профили, заказы, позиции, платежи, чат…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="305.0" y="690.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;Хранилище видео&lt;/b&gt;&lt;br&gt;S3-совместимое: портфолио и ролики до 200 МБ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="726.2" y="690.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;очередь фоновых задач, кэш каталога" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1147.5" y="690.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v29" value="&lt;b&gt;Резервные копии&lt;/b&gt;&lt;br&gt;журнал каждые 15 мин + ежедневно, восстановление ≤ 4 ч" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1568.8" y="690.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v30" value='&lt;b&gt;5. Внешние сервисы&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;не наши, но от них зависим&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;fontColor=#FFFFFF;strokeColor=none;fontSize=18;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="850.0" width="250.0" height="120.0" as="geometry"/></mxCell><mxCell id="v31" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290.0" y="850.0" width="1700.0" height="120.0" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;Payme / Click&lt;/b&gt;&lt;br&gt;оплата с удержанием, выплата, возврат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="305.0" y="865.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v33" value="&lt;b&gt;SMS-шлюз&lt;/b&gt;&lt;br&gt;одноразовые коды входа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="726.2" y="865.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;уведомления о статусах" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1147.5" y="865.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;Налоговый комитет&lt;/b&gt;&lt;br&gt;статус самозанятого — в версии 1 вручную" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1568.8" y="865.0" width="406.2" height="90.0" as="geometry"/></mxCell><mxCell id="e36" value="HTTPS (TLS) · JSON" style="html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v4" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="вызовы модулей внутри одного приложения" style="html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v9" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="SQL · файлы · очередь" style="html=1;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v14" target="v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="внешние API" style="html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v25" target="v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>